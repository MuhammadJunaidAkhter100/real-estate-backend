[Unit]
Description=Axiyon Celery default queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/real-estate-backend
Environment=CELERY_DEFAULT_WORKER_CONCURRENCY=2
EnvironmentFile=/home/ubuntu/real-estate-backend/.env
ExecStart=/home/ubuntu/real-estate-backend/venv/bin/celery -A api worker --loglevel=INFO --queues=celery --concurrency=${CELERY_DEFAULT_WORKER_CONCURRENCY} --prefetch-multiplier=1
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
