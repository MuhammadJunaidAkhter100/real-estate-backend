[Unit]
Description=Axiyon Celery Beat scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/real-estate-backend
EnvironmentFile=/home/ubuntu/real-estate-backend/.env
ExecStart=/home/ubuntu/real-estate-backend/venv/bin/celery -A api beat --loglevel=INFO --schedule=/home/ubuntu/real-estate-backend/celerybeat-schedule
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
